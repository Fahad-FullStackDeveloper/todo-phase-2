# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js
.next/
out/
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
*.lcov

# Docker
docker-compose.override.yml
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.tmp/
.temp/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Vercel
.vercel

# Testing
playwright-report/
test-results/
