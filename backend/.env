# =============================================================================
# Database Configuration
# =============================================================================
# Local development (Docker):
# DATABASE_URL=postgresql://todoflow:todoflow_secret@localhost:5432/todoflow

# Production (Neon Serverless PostgreSQL):
DATABASE_URL=postgresql://neondb_owner:npg_rk4xcO1EvXML@ep-calm-bread-aibpjgyg-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# Authentication Configuration
# =============================================================================
# IMPORTANT: Generate a secure random string (min 32 characters) for production
# This secret MUST match the frontend BETTER_AUTH_SECRET for JWT verification
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=HsduZG33aPVPdV9jnUFcU99prirMEk8s

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Include both local and deployed frontend URLs
FRONTEND_URL=http://localhost:3000,https://todo-phase-2-theta.vercel.app

# =============================================================================
# SQL Debug (Optional)
# =============================================================================
# Set to 'true' to log all SQL queries (development only)
SQL_ECHO=false
