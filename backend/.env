# Database Configuration
# Replace with your actual Neon PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todoflow

# SQL Debug (optional - set to 'true' to log SQL queries)
SQL_ECHO=false

# Authentication Configuration
# IMPORTANT: Change this to a secure random string (min 32 characters) for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=todoflow-dev-secret-key-change-in-production-min-32-chars

# Frontend Configuration
# Comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
