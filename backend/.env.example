# Database Configuration
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/todoflow?sslmode=require

# SQL Debug (optional)
SQL_ECHO=false

# Authentication Configuration
# IMPORTANT: Generate a secure random string (min 32 characters) for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=your-secure-random-secret-key-min-32-characters

# Frontend Configuration
# Comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:3000
