# =============================================================================
# TodoFlow Root Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control
# =============================================================================

# =============================================================================
# Database Configuration (PostgreSQL - Neon Compatible)
# =============================================================================
# Local development database connection
DB_USER=todoflow
DB_PASSWORD=todoflow_secret
DB_NAME=todoflow
DB_PORT=5432

# For production with Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/todoflow?sslmode=require

# =============================================================================
# Authentication Configuration
# =============================================================================
# IMPORTANT: Generate a secure random string (min 32 characters) for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This secret MUST be shared between frontend (Better Auth) and backend (FastAPI)
BETTER_AUTH_SECRET=your-secure-random-secret-key-min-32-characters

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# =============================================================================
# Development-Only Configuration
# =============================================================================
# Admin password for development-only endpoints (e.g., DELETE /api/auth/users/{email})
# WARNING: These endpoints should be disabled/removed in production!
ADMIN_PASSWORD=admin123

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000,http://frontend:3000
SQL_ECHO=false

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# Redis Configuration (Optional - for caching/sessions)
# =============================================================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
